# Real-Integration (read-only) environment template — Task 7.3D-2.
# Copy to .env.real-readonly and fill in from your deployment's secret
# channel. NEVER commit filled copies. The Compose file pins
# DATABASE_URL, ACTUATOR_EXECUTION_ENABLED and worker flags itself.

# --- Real Mode switches (the whole point of this configuration) ---
WORKER_ENABLED=true
SNAP4CITY_INGEST_ENABLED=true
GUARDIAN_SHADOW_RECONCILIATION_ENABLED=true
# Task 7.3E-3: evidence source for the local Windows exercise.
# audit_tail consumes GET /v1/verdict?since= (UNAUTHENTICATED; loopback only).
# integration_verdicts is the authenticated HTTPS contract (default).
GUARDIAN_EVIDENCE_SOURCE=audit_tail
GUARDIAN_AUDIT_CURSOR_FILE=./real_integration.audit-cursor.json

# --- External endpoints ---
# Hosted Orion NGSI-v2 broker of the partner root stack (TLS verified; the
# launcher preflight also checks the certificate before any Brain process
# relies on it).
ORION_BASE_URL=https://smartopia.polytecsousse.dev/orion-filter/orion-1
# Guardian integration API MUST be HTTPS (Brain fails closed otherwise).
# Task 7.3E-1 exception: for the LOCAL Windows exercise only, the real
# Guardian serves plain HTTP on a loopback address. Setting the flag below
# permits HTTP **only** to 127.0.0.0/8, ::1 or localhost, never in the
# production environment, and only with an explicit opt-in here.
GUARDIAN_BASE_URL=http://127.0.0.1:8090
GUARDIAN_ALLOW_LOOPBACK_HTTP=true
# Must equal the Guardian server's GUARDIAN_INTEGRATION_TOKEN env value.
GUARDIAN_INTEGRATION_TOKEN=

# --- Brain API credentials (Brain's own ingest API) ---
BRAIN_API_KEY=
TWIN_API_KEY=
GUARDIAN_API_KEY=
BRAIN_BASE_URL=http://brain-real:8000

# --- Identity + mapping ---
GUARDIAN_IDENTITY=triplet-guardian
SNAP4CITY_DEVICES_FILE=config/devices.real-readonly.yaml
CITY_REGISTRY_FILE=config/city.real-readonly.yaml
INCIDENT_RULES_FILE=config/incidents.real-readonly.yaml
DECISION_POLICY_FILE=config/policies.yaml

# --- Timing (compatible with the Twin's ~5 s tick) ---
EVENT_FRESHNESS_SECONDS=300
SNAP4CITY_POLL_SECONDS=5
GUARDIAN_SHADOW_POLL_SECONDS=30
GUARDIAN_SHADOW_TIMEOUT_SECONDS=5

# --- Safety pins (do not relax for the read-only exercise) ---
ACTUATOR_EXECUTION_ENABLED=false
ACTUATOR_TRANSPORT=orion
OPERATIONAL_DEMO_ENABLED=false
OPERATIONAL_AUTO_APPROVE=false

# --- Isolated database (never the mock/demo city_brain.db) ---
DATABASE_URL=sqlite:///./real_integration.db

AEGISCITY_MODE=mock
ENVIRONMENT=development
DATABASE_URL=sqlite:///./city_brain_demo.db
BRAIN_API_KEY=replace-with-distinct-32-character-minimum-key
TWIN_API_KEY=replace-with-distinct-32-character-minimum-key
GUARDIAN_API_KEY=replace-with-distinct-32-character-minimum-key
BRAIN_BASE_URL=http://127.0.0.1:8001
TWIN_BASE_URL=http://127.0.0.1:8101
GUARDIAN_BASE_URL=http://127.0.0.1:8102
CITY_REGISTRY_FILE=config/city.demo.yaml
INCIDENT_RULES_FILE=config/incidents.demo.yaml
DECISION_POLICY_FILE=config/policies.demo.yaml
WORKER_ENABLED=true
OPERATIONAL_DEMO_ENABLED=true
OPERATIONAL_AUTO_APPROVE=false
ACTUATOR_EXECUTION_ENABLED=true
ACTUATOR_TRANSPORT=mock_twin
MOCK_SIMULATION_AUTO_START=true
MOCK_SIMULATION_INTERVAL_SECONDS=1
MOCK_SIMULATION_SEED=2026
MOCK_TWIN_ALLOWED_ACTIONS=demo_signal_optimize,demo_fire_alarm,demo_flood_response
TRAFFIC_MODEL_DIR=
WATER_MODEL_PATH=
